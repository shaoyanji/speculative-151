#!/usr/bin/env bash
#
# v2-score — score v2 1-N-1 candidates with Jev and pick the winner.
#
# Input:  candidates JSON — either [{"slot":1,"text":"..."},...] or {"1":"...","2":"..."}
# Output: score JSON on stdout:
#   {"raw_scores":{"1":0.72,...},"grades":{"1":1.0,...},"scores":{"1":0.72,...},
#    "winner":1,"margin":0.08,"threshold":0.05,"decision":"SHIP"}
#   raw_scores = unmodified first-preference Jev noul p per candidate (the gut).
#   grades     = per-candidate risk multiplier in (0,1] (default 1.0).
#   scores     = final rank scores = raw p x grade (Kelly split).
# Exit 0 on SHIP, 3 on NO_RESULT (top-two final gap < threshold: do not crown a tie),
# 2 on usage/validation errors, 4 if jevq failed or timed out.
#
# Independence: the jevq batch call has its OWN timeout (default 120s, hard-kill
# 10s after TERM). A grader timeout/failure exits 4 immediately — it never hangs,
# and candidate-generation timeouts NEVER cascade into this stage: scoring proceeds
# with however many candidates finished (minimum 2, else fail loudly).
#
# Raw-first: the unmodified Jev p's are emitted (stderr + --scores-out + ledger)
# BEFORE any grade multiplication, discounting, or NO_RESULT logic. The first
# preference is never lost to downstream adjustments.
#
# Kelly split: Jev provides the gut probability p; a separate grade provides the
# multiplier b (net-odds risk discount). p comes ONLY from Jev; b comes ONLY from
# the grade — never mixed at the source. Without --grades, b=1.0 for all slots
# (pure Jev ranking, legacy behavior).
#
# Usage:
#   v2-score --candidates cands.json [--question "..."] [--state "..."]
#            [--threshold 0.05] [--timeout 120] [--ledger ledger.jsonl]
#            [--scores-out raw.json] [--grades '{"1":0.9,...}' | @grades.json]
#
#   jq -r '.winner'                  # winning slot
#   jq -r '.decision'                # SHIP or NO_RESULT
#   jq -r '.raw_scores'              # unmodified first-preference p's

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/guardrails.sh
source "$SCRIPT_DIR/../lib/guardrails.sh"

CANDIDATES=""
QUESTION="Is this the best response?"
STATE=""
THRESHOLD="0.05"
TIMEOUT_S=120
LEDGER=""
SCORES_OUT=""
GRADES_ARG=""

usage() {
  cat <<'EOF'
Usage: v2-score --candidates FILE [--question Q] [--state S] [--threshold T]
                [--timeout SEC] [--ledger FILE] [--scores-out FILE]
                [--grades JSON | @FILE]

  --candidates  JSON file: [{"slot":1,"text":"..."},...] or {"1":"...","2":"..."} (required)
  --question    noul question per candidate (default: "Is this the best response?")
  --state       shared state passed to jevq as positional (default: none)
  --threshold   min top-two final gap to SHIP; below -> NO_RESULT exit 3 (default: 0.05)
  --timeout     seconds for the jevq call (default: 120; TERM then KILL 10s later;
                grader never hangs, never waits on candidate generation)
  --ledger      append audit JSONL line to FILE (carries raw_scores AND decision)
  --scores-out  write the RAW unmodified Jev p's to FILE immediately, before
                any grade multiplication or threshold logic
  --grades      per-candidate risk multiplier, JSON object {"1":0.9,...} or @file;
                each grade in (0,1]; missing slots default to 1.0 (pure Jev ranking)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --candidates) CANDIDATES="${2:?--candidates needs a value}"; shift 2 ;;
    --question)   QUESTION="${2:?--question needs a value}"; shift 2 ;;
    --state)      STATE="${2:?--state needs a value}"; shift 2 ;;
    --threshold)  THRESHOLD="${2:?--threshold needs a value}"; shift 2 ;;
    --timeout)    TIMEOUT_S="${2:?--timeout needs a value}"; shift 2 ;;
    --ledger)     LEDGER="${2:?--ledger needs a value}"; shift 2 ;;
    --scores-out) SCORES_OUT="${2:?--scores-out needs a value}"; shift 2 ;;
    --grades)     GRADES_ARG="${2:?--grades needs a value}"; shift 2 ;;
    -h|--help)    usage; exit 0 ;;
    *) echo "error: unknown flag: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$CANDIDATES" ]] || { echo "error: --candidates is required" >&2; exit 2; }
[[ -f "$CANDIDATES" ]] || { echo "error: candidates file not found: $CANDIDATES" >&2; exit 2; }
THRESHOLD="$(guard_threshold "$THRESHOLD")" || exit 2
[[ "$TIMEOUT_S" =~ ^[0-9]+$ ]] && (( TIMEOUT_S > 0 )) || {
  echo "error: --timeout must be a positive integer" >&2; exit 2; }
command -v jq >/dev/null || { echo "error: jq is required" >&2; exit 2; }
command -v jevq >/dev/null || { echo "error: jevq not found on PATH (~/bin/jevq)" >&2; exit 2; }

TMPDIR_WORK="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_WORK"' EXIT

# Normalize candidates to [{"slot":N,"text":"..."}], dropping empty texts.
# Whatever the fan-out stage produced, scoring proceeds with the finishers.
jq -c '
  if type == "array" then
    [.[] | select(.text != null and (.text | tostring | ltrimstr(" ") | rtrimstr(" ") | length > 0))
         | {slot: (.slot | tonumber), text: (.text | tostring)}]
  elif type == "object" then
    [to_entries[] | select(.value != null and (.value | tostring | ltrimstr(" ") | rtrimstr(" ") | length > 0))
         | {slot: (.key | tonumber), text: (.value | tostring)}]
  else empty end
  | sort_by(.slot)
' "$CANDIDATES" > "$TMPDIR_WORK/cands.json"

NVALID="$(jq 'length' "$TMPDIR_WORK/cands.json")"
if (( NVALID < 2 )); then
  echo "error: need >= 2 non-empty candidates to judge, got $NVALID" >&2
  exit 2
fi

# Build jevq batch items: [{"id":"<slot>","q":"..."}]
jq -c --arg q "$QUESTION" '
  map({id: (.slot | tostring),
       q: ("Candidate " + (.slot | tostring) + " response:\n" + .text + "\n\n" + $q)})
' "$TMPDIR_WORK/cands.json" > "$TMPDIR_WORK/items.json"

# --- GRADER STAGE (independent): one bounded jevq call. ---------------------
# Own timeout; TERM at TIMEOUT_S, hard KILL 10s later so the grader can never
# hang. A timeout/failure exits 4 immediately — candidate-generation timeouts
# never cascade into this stage.
JEVQ_TIMEOUT_KILL=10
if [[ -n "$STATE" ]]; then
  if ! timeout -k "$JEVQ_TIMEOUT_KILL" "$TIMEOUT_S" jevq "$STATE" --batch @"$TMPDIR_WORK/items.json" > "$TMPDIR_WORK/resp.json" 2>"$TMPDIR_WORK/jevq.err"; then
    echo "error: jevq failed or timed out after ${TIMEOUT_S}s (grader timeout is independent; exit 4)" >&2
    cat "$TMPDIR_WORK/jevq.err" >&2 || true
    exit 4
  fi
else
  if ! timeout -k "$JEVQ_TIMEOUT_KILL" "$TIMEOUT_S" jevq --batch @"$TMPDIR_WORK/items.json" > "$TMPDIR_WORK/resp.json" 2>"$TMPDIR_WORK/jevq.err"; then
    echo "error: jevq failed or timed out after ${TIMEOUT_S}s (grader timeout is independent; exit 4)" >&2
    cat "$TMPDIR_WORK/jevq.err" >&2 || true
    exit 4
  fi
fi

# --- RAW FIRST SCORE: unmodified Jev p's, captured BEFORE anything else. ----
# This is the gut probability. It is emitted now — stderr, --scores-out,
# ledger — and is never recomputed or lost to downstream adjustments.
jq -c '
  (.answers // {}) | with_entries(.value |= (.noul // 0))
' "$TMPDIR_WORK/resp.json" > "$TMPDIR_WORK/raw.json"

echo "raw_scores: $(cat "$TMPDIR_WORK/raw.json")" >&2
if [[ -n "$SCORES_OUT" ]]; then
  cp "$TMPDIR_WORK/raw.json" "$SCORES_OUT"
  echo "raw_scores: written to $SCORES_OUT" >&2
fi

# --- KELLY SPLIT: grade b multiplies gut p. ---------------------------------
# Parse --grades (JSON object or @file); missing slots default to 1.0.
# Each grade is validated in (0,1]. p comes only from Jev; b only from here.
if [[ -z "$GRADES_ARG" ]]; then
  jq -c 'map(.slot | tostring) | map({key: ., value: 1.0}) | from_entries' \
    "$TMPDIR_WORK/cands.json" > "$TMPDIR_WORK/grades.json"
else
  if [[ "$GRADES_ARG" == @* ]]; then
    GFILE="${GRADES_ARG#@}"
    [[ -f "$GFILE" ]] || { echo "error: grades file not found: $GFILE" >&2; exit 2; }
  else
    GFILE="$TMPDIR_WORK/grades_arg.json"
    printf '%s' "$GRADES_ARG" > "$GFILE"
  fi
  jq -e 'type == "object"' "$GFILE" >/dev/null \
    || { echo "error: --grades must be a JSON object {slot: grade}" >&2; exit 2; }
  jq -c --slurpfile c "$TMPDIR_WORK/cands.json" '
    ($c[0] | map(.slot | tostring)) as $slots
    | . as $g
    | reduce $slots[] as $s ({}; .[$s] = ($g[$s] // 1.0))
  ' "$GFILE" > "$TMPDIR_WORK/grades.json" \
    || { echo "error: could not parse --grades" >&2; exit 2; }
fi
while IFS= read -r slot; do
  g="$(jq -r --arg s "$slot" '.[$s]' "$TMPDIR_WORK/grades.json")"
  guard_grade "$g" >/dev/null || exit 2
done < <(jq -r 'keys[]' "$TMPDIR_WORK/grades.json")

# Final rank scores = raw p x grade, per slot.
jq -c -s '
  .[0] as $raw | .[1] as $grades
  | reduce ($raw | keys[]) as $k ({}; .[$k] = ($raw[$k] * ($grades[$k] // 1.0)))
' "$TMPDIR_WORK/raw.json" "$TMPDIR_WORK/grades.json" > "$TMPDIR_WORK/final.json"

# Rank on FINAL scores; margin and decision follow the same numbers.
RESULT="$(jq -c --argjson t "$THRESHOLD" --slurpfile raw "$TMPDIR_WORK/raw.json" --slurpfile gr "$TMPDIR_WORK/grades.json" '
  to_entries | sort_by(-.value) as $r
  | ($r[0]) as $top | ($r[1]) as $second
  | (($top.value - ($second.value // 0))) as $margin
  | {
      raw_scores: $raw[0],
      grades: $gr[0],
      scores: (from_entries),
      winner: ($top.key | tonumber),
      margin: $margin,
      threshold: $t,
      decision: (if $margin < $t then "NO_RESULT" else "SHIP" end)
    }
' "$TMPDIR_WORK/final.json")"

echo "$RESULT" | jq .

if [[ -n "$LEDGER" ]]; then
  TS="$(date +%s)"
  echo "$RESULT" | jq -c --argjson ts "$TS" --argjson n "$NVALID" \
    '{ts: $ts, n_candidates: $n} + .' >> "$LEDGER"
  echo "ledger: appended (raw_scores + grades + decision) to $LEDGER" >&2
fi

DECISION="$(echo "$RESULT" | jq -r '.decision')"
[[ "$DECISION" == "SHIP" ]] || exit 3
